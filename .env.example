# Root environment file consumed by docker-compose.yml (12-factor config).
# Copy to `.env` (gitignored -- never commit it) and fill in real values:
#   cp .env.example .env
#
# Backend-specific application settings are also documented in
# backend/.env.example; the variable names here match so one root `.env`
# drives both `docker compose up` and a locally-run
# `uvicorn app.main:app --reload` from backend/.

# --- Postgres (pgvector) ---
POSTGRES_USER=delivery
POSTGRES_PASSWORD=delivery
POSTGRES_DB=delivery
POSTGRES_PORT=5432

# --- Redis ---
REDIS_PORT=6379

# --- Backend service ---
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg://delivery:delivery@db:5432/delivery
REDIS_URL=redis://redis:6379/0

# --- GitHub connector (scoped token only, never a full-access PAT) ---
GITHUB_TOKEN=

# --- Jira connector ---
JIRA_BASE_URL=https://hemchandkodali.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=

# Jira custom field id for Story Points - instance-specific. Resolve via
# GET /rest/api/3/field at OAuth time; default matches the curated demo
# dataset only (see backend/.env.example).
JIRA_STORY_POINTS_FIELD=customfield_10016
