# Database
DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/delivery

# GitHub connector
GITHUB_TOKEN=

# Jira connector
JIRA_BASE_URL=https://hemchandkodali.atlassian.net
JIRA_EMAIL=
JIRA_TOKEN=

# Jira custom field id for Story Points on this instance.
# Resolve via GET /rest/api/3/field at OAuth time -- do not assume it matches
# other Jira instances. Defaults to customfield_10016 (the id used by the
# curated demo dataset for the SCRUM project).
JIRA_STORY_POINTS_FIELD=customfield_10016
